<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="PlayerViewController" customModule="LevelAssignment" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="Zx0-view-root" id="Zx0-conn-view"/>
                <outlet property="artworkImageView" destination="Zx0-img-artwork" id="Zx0-conn-img"/>
                <outlet property="titleLabel" destination="Zx0-lbl-title" id="Zx0-conn-title"/>
                <outlet property="teacherLabel" destination="Zx0-lbl-teacher" id="Zx0-conn-teacher"/>
                <outlet property="progressSlider" destination="Zx0-sld-progress" id="Zx0-conn-slider"/>
                <outlet property="elapsedTimeLabel" destination="Zx0-lbl-elapsed" id="Zx0-conn-elapsed"/>
                <outlet property="remainingTimeLabel" destination="Zx0-lbl-remaining" id="Zx0-conn-remaining"/>
                <outlet property="speedButton" destination="Zx0-btn-speed" id="Zx0-conn-speed"/>
                <outlet property="playPauseButton" destination="Zx0-btn-playpause" id="Zx0-conn-playpause"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="Zx0-view-root">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="20" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-stack-root">
                    <rect key="frame" x="20" y="76" width="353" height="400"/>
                    <subviews>
                        <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-img-artwork">
                            <rect key="frame" x="0.0" y="0.0" width="353" height="200"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="200" id="Zx0-con-imgheight"/>
                            </constraints>
                        </imageView>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Session Title" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-lbl-title">
                            <rect key="frame" x="0.0" y="220" width="353" height="24"/>
                            <fontDescription key="fontDescription" style="UICTFontTextStyleTitle2" pointSize="20"/>
                            <nil key="textColor"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Teacher" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-lbl-teacher">
                            <rect key="frame" x="0.0" y="264" width="353" height="18"/>
                            <fontDescription key="fontDescription" style="UICTFontTextStyleSubhead"/>
                            <color key="textColor" systemColor="secondaryLabelColor"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <slider opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-sld-progress">
                            <rect key="frame" x="0.0" y="302" width="353" height="31"/>
                            <connections/>
                        </slider>
                        <stackView opaque="NO" contentMode="scaleToFill" distribution="equalSpacing" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-stack-time">
                            <rect key="frame" x="0.0" y="353" width="353" height="18"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="0:00" textAlignment="left" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-lbl-elapsed">
                                    <rect key="frame" x="0.0" y="0.0" width="40" height="18"/>
                                    <fontDescription key="fontDescription" style="UICTFontTextStyleCaption1"/>
                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                    <nil key="highlightedColor"/>
                                </label>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="-0:00" textAlignment="right" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-lbl-remaining">
                                    <rect key="frame" x="313" y="0.0" width="40" height="18"/>
                                    <fontDescription key="fontDescription" style="UICTFontTextStyleCaption1"/>
                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                    <nil key="highlightedColor"/>
                                </label>
                            </subviews>
                        </stackView>
                        <stackView opaque="NO" contentMode="scaleToFill" distribution="equalCentering" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-stack-buttons">
                            <rect key="frame" x="0.0" y="391" width="353" height="44"/>
                            <subviews>
                                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-btn-speed">
                                    <rect key="frame" x="0.0" y="0.0" width="44" height="44"/>
                                    <state key="normal" title="1x"/>
                                    <connections/>
                                </button>
                                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="Zx0-btn-playpause">
                                    <rect key="frame" x="68" y="0.0" width="44" height="44"/>
                                    <state key="normal" title="Play"/>
                                    <connections/>
                                </button>
                            </subviews>
                        </stackView>
                    </subviews>
                </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="Zx0-safe-area"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstItem="Zx0-stack-root" firstAttribute="leading" secondItem="Zx0-safe-area" secondAttribute="leading" constant="20" id="Zx0-con-leading"/>
                <constraint firstItem="Zx0-safe-area" firstAttribute="trailing" secondItem="Zx0-stack-root" secondAttribute="trailing" constant="20" id="Zx0-con-trailing"/>
                <constraint firstItem="Zx0-stack-root" firstAttribute="top" secondItem="Zx0-safe-area" secondAttribute="top" constant="24" id="Zx0-con-top"/>
            </constraints>
        </view>
    </objects>
    <resources/>
</document>
